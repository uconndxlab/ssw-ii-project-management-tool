      "css": ".ds-org{font-family:var(--bs-font-sans-serif,system-ui,sans-serif);display:inline-block;padding:.35em .65em;font-size:.75rem;font-weight:700;line-height:1;color:var(--entity-org-text,#4a5568);background:var(--entity-org-bg,#eef1f6);border:1px solid var(--entity-org-border,#d8dee9);border-radius:.375rem;text-decoration:underline}.ds-org:hover,.ds-org:active{color:var(--entity-org-text,#4a5568)}.ds-org:focus-visible{outline:2px solid var(--bs-primary,#0d6efd);outline-offset:2px}"
    },
    {
      "name": "Section Card",
      "kind": "card",
      "refersTo": "section-card",
      "description": "Shared white working surface with a subtle structural shadow.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Details</h2><p class=\"ds-card-subtitle\">Related information</p><p class=\"ds-card-body\">Section content</p></section>",
      "css": ".ds-card{font-family:var(--bs-font-sans-serif,system-ui,sans-serif);padding:1rem;background:var(--bs-body-bg,#fff);color:var(--bs-body-color,#212529);border:1px solid rgba(0,0,0,.175);border-radius:.375rem;box-shadow:0 .125rem .25rem rgba(0,0,0,.075)}.ds-card-title{margin:0;font-size:1.25rem;font-weight:500;line-height:1.2}.ds-card-subtitle{margin:.25rem 0 1rem;color:var(--bs-secondary-color,rgba(33,37,41,.75));font-size:.875rem;line-height:1.5}.ds-card-body{margin:0;font-size:1rem;line-height:1.5}"
    },
    {
      "name": "Primary Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Dark navigation with a thin underline for the current destination; condensed sample of desktop links.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a class=\"ds-brand\" href=\"#home\">TA Tracker</a><a class=\"ds-nav-link ds-current\" aria-current=\"page\" href=\"#home\">Home</a><a class=\"ds-nav-link\" href=\"#agreements\">Agreements</a><a class=\"ds-nav-link\" href=\"#activities\">Activities</a></nav>",
      "css": ".ds-nav{font-family:var(--bs-font-sans-serif,system-ui,sans-serif);display:flex;flex-wrap:wrap;align-items:center;background:#212529;padding:.5rem .75rem}.ds-brand{font-size:1.25rem;line-height:1.5;color:#fff;text-decoration:none;margin-right:1rem}.ds-nav-link{color:rgba(255,255,255,.55);padding:.5rem;font-size:1rem;line-height:1.5;text-decoration:none}.ds-nav-link:hover,.ds-nav-link:focus-visible{color:rgba(255,255,255,.75)}.ds-current{color:#fff;font-weight:600;box-shadow:inset 0 -1px 0 rgba(255,255,255,.75)}.ds-nav-link:focus-visible,.ds-brand:focus-visible{outline:2px solid #fff;outline-offset:2px}.ds-nav-link:active{color:#fff}"
    },
    {
      "name": "Relationship Ledger Row",
      "kind": "custom",
      "description": "Bordered row with a linked record title and muted subordinate metadata.",
      "html": "<article class=\"ds-ledger\"><a class=\"ds-ledger-title\" href=\"#record\">Agreement name</a><div class=\"ds-ledger-meta\">Related organization</div></article>",
      "css": ".ds-ledger{font-family:var(--bs-font-sans-serif,system-ui,sans-serif);padding:.5rem 1rem;background:var(--bs-body-bg,#fff);border:1px solid var(--bs-border-color,#dee2e6);border-radius:.375rem}.ds-ledger-title{font-size:.875rem;font-weight:600;line-height:1.5;color:var(--bs-link-color,#0d6efd);text-decoration:underline}.ds-ledger-title:hover,.ds-ledger-title:active{color:var(--bs-link-hover-color,#0a58ca)}.ds-ledger-title:focus-visible{outline:2px solid var(--bs-primary,#0d6efd);outline-offset:2px}.ds-ledger-meta{margin-top:.25rem;font-size:.875rem;line-height:1.5;color:var(--bs-secondary-color,rgba(33,37,41,.75))}"
    },
    {
      "name": "Save Bar",
      "kind": "custom",
      "description": "Static preview of the fixed form footer in its unsaved state; production behavior lives in x-save-bar.",
      "html": "<div class=\"ds-save\"><span class=\"ds-save-status\">● Unsaved changes</span><div class=\"ds-save-actions\"><button class=\"ds-button ds-save-cancel\">Cancel</button><button class=\"ds-button ds-save-button\">Save</button></div></div>",
      "css": ".ds-button{font-family:var(--bs-font-sans-serif,system-ui,sans-serif);font-size:1rem;font-weight:400;line-height:1.5;padding:.375rem .75rem;border:1px solid;border-radius:.375rem;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out}.ds-button:disabled{opacity:.65;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-save{font-family:var(--bs-font-sans-serif,system-ui,sans-serif);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;padding:.5rem .75rem;min-height:54px;background:#fff;border-top:1px solid #dee2e6;box-shadow:0 -2px 12px rgba(0,0,0,.08)}.ds-save-status{font-size:.875rem;font-weight:600;color:var(--bs-warning,#ffc107)}.ds-save-actions{display:flex;gap:.5rem}.ds-save .ds-button{font-size:.875rem;padding:.25rem .5rem;border-radius:.25rem}.ds-save-button{color:#fff;background:var(--bs-primary,#0d6efd);border-color:var(--bs-primary,#0d6efd)}.ds-save-button:hover,.ds-save-button:focus-visible{background:#0b5ed7;border-color:#0a58ca}.ds-save-button:active{background:#0a58ca}.ds-save-cancel{color:var(--bs-secondary,#6c757d);background:transparent;border-color:var(--bs-secondary,#6c757d)}.ds-save-cancel:hover,.ds-save-cancel:focus-visible,.ds-save-cancel:active{color:#fff;background:var(--bs-secondary,#6c757d)}.ds-save-button:focus-visible,.ds-save-cancel:focus-visible{outline:0;box-shadow:0 0 0 .25rem rgba(49,132,253,.5)}"
    }
  ],
  "narrative": {
    "northStar": "The Working Ledger",
    "overview": "A practical, orderly, restrained interface for working with agreements, activities, organizations, and related records. Familiar controls and a stable visual hierarchy keep attention on the work. White working surfaces sit over Cool Slate; Action Blue identifies primary actions and links.\n\nComponents are practical and restrained. Depth is layered: subtle shadows separate working surfaces, while borders, headings, and compact badges organize the information inside them. The system uses a single system sans-serif family, clear labels, and responsive Bootstrap grids.",
    "keyCharacteristics": [
      "Cool neutral canvas, white working surfaces, and blue actions.",
      "Compact metadata and tables alongside clearly grouped forms.",
      "Consistent entity colors and labeled status indicators.",
      "Small corner radii, thin borders, and subtle structural shadows."
    ],
    "rules": [
      {
        "name": "The Entity Color Rule",
        "body": "Reuse `EntityBadge` mappings across related records, type labels, and counts. Entity color conveys record kind; labeled status pills convey active or inactive state.",
        "section": "colors"
      },
      {
        "name": "The Label Hierarchy Rule",
        "body": "Keep ordinary labels in sentence case; reserve tracked uppercase for subsection titles and entity-type labels.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Use existing card, drawer, and save-bar treatments for their respective layers; keep internal relationship rows visually subordinate.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reuse the shared page header, form shell, section card, field, and save bar components.",
      "**Do** use the existing entity palette consistently for record kinds and labeled status pills for state.",
      "**Do** keep help and metadata subordinate with small text and muted color.",
      "**Do** retain responsive table wrappers, wrapping metadata, and drawer body scrolling.",
      "**Do** preserve visible focus treatments and the shared save-status announcement."
    ],
    "donts": [
      "**Don't** put Active switches, filters, or form controls in the page header.",
      "**Don't** mix header-style cards with section-card form sections on the same form.",
      "**Don't** add in-card submit/cancel controls to forms that use the sticky save bar.",
      "**Don't** introduce a new per-page form shell or remap entity colors independently.",
      "**Don't** replace ordinary sentence-case labels with tracked uppercase metadata styling."
    ]
  }
}
